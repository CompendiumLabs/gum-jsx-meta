{
  "name": "gum-jsx-workspace",
  "private": true,
  "workspaces": [
    "gum-jsx",
    "gum-jsx-core",
    "gum-jsx-math",
    "gum-jsx-png",
    "gum-jsx-mp4",
    "gum-jsx-pdf",
    "gum-jsx-pptx",
    "gum-jsx-react",
    "gum-jsx-mark",
    "gum-jsx-cli",
    "gum-jsx-edit",
    "gum-jsx-docs",
    "gum-jsx-maps"
  ],
  "scripts": {
    "build": "bun run --cwd gum-jsx-png build && bun run --cwd gum-jsx-mp4 build && bun run --cwd gum-jsx build && bun run --cwd gum-jsx-mark build",
    "plugin:build": "bun gum-jsx-docs/scripts/plugin-build.ts",
    "plugin:pack": "bun gum-jsx-docs/scripts/plugin-pack.ts",
    "skill:build": "bun gum-jsx-docs/scripts/skill-build.ts",
    "skill:pack": "bun gum-jsx-docs/scripts/skill-pack.ts",
    "visual-report": "bun --filter @gum-jsx/cli visual-report",
    "typecheck": "bun run --workspaces typecheck",
    "test": "bun --no-orphans test/run.ts",
    "perf": "bun test/perf.ts",
    "rehearse": "bash scripts/rehearse.sh"
  }
}
